# Copy to .env.local and fill in. NEXT_PUBLIC_ vars are exposed to the browser —
# that's fine here: the Worker URL is public; the bot TOKEN stays inside the Worker.
NEXT_PUBLIC_LEAD_ENDPOINT=https://aqly-lead.YOUR-SUBDOMAIN.workers.dev

# ElevenLabs Conversational-AI agent. The agent-id is PUBLIC by design — lock it
# to your domain in the ElevenLabs dashboard (agent → Security → allowed domains,
# public agent / auth disabled). Create the agent at elevenlabs.io → Agents.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=your_agent_id_here
